TESTAH_APP_NAME=Testah API
TESTAH_DATABASE_URL=sqlite:///./testah.db
# JSON array of allowed browser origins.
TESTAH_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

TESTAH_ENVIRONMENT=development
# Only development exposes the explicit POST /api/rai/diagnostics check.
# It never runs automatically and is absent from test/production.
TESTAH_ALLOW_LOCAL_SAMPLE=false
TESTAH_AGENT_TIMEOUT_SECONDS=10
TESTAH_AGENT_MAX_RESPONSE_BYTES=65536
# Server-only map of reference keys to complete header values. Never send values to the UI.
TESTAH_AGENT_SECRETS={}

# Separate shared operator token for monitoring, never a Gemini/agent key.
# Empty disables SSE; use a randomly generated 32+ character token locally.
# Required in production: a distinct random 32+ character token for a shared workspace.
TESTAH_WORKSPACE_ACCESS_TOKEN=
TESTAH_MONITOR_TOKEN=
TESTAH_MONITOR_POLL_SECONDS=0.5
TESTAH_MONITOR_HEARTBEAT_SECONDS=10
TESTAH_MONITOR_MAX_STREAMS=16

# Phase 7: all PayPal calls are Sandbox-only. Mode freezes when a run is created.
# Missing/invalid Sandbox credentials fail closed; no simulation fallback.
TESTAH_PAYMENT_MODE=simulated
# Separate 32+ character random operator token for payment UI/reconciliation/capture.
# Must differ from TESTAH_MONITOR_TOKEN. Never put either token in VITE_ variables.
TESTAH_PAYMENT_OPERATOR_TOKEN=
TESTAH_PAYPAL_ENVIRONMENT=sandbox
TESTAH_PAYPAL_CLIENT_ID=
TESTAH_PAYPAL_CLIENT_SECRET=
# For merchant changes, stage a separate ignored .env file and validate it with
# scripts/check_paypal_configuration.py --env-file .env.paypal-us --authenticate
# OAuth only; verify account country, app association and USD preferences separately.
# Keep credential values empty or replace local placeholders; placeholders block payment operations.
# Optional exact Sandbox business merchant pin. Blank uses the app's own merchant.
# Remove placeholders; never use an email, Classic API username or Client ID.
TESTAH_PAYPAL_MERCHANT_ID=
TESTAH_PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
TESTAH_PAYPAL_TIMEOUT_SECONDS=10
# 0-2 retries within the total request deadline. Financial POSTs require stable request IDs.
TESTAH_PAYPAL_RETRIES=1
# Render: exact public HTTPS API origin, no path/query/fragment/credentials.
# Local development uses loopback. Never derive this from the Host header.
TESTAH_PAYPAL_CALLBACK_BASE_URL=http://127.0.0.1:8000
TESTAH_PAYPAL_APPROVAL_WAIT_SECONDS=600

# Per-run controller limits, frozen at assessment creation. No outbound POST retries.
TESTAH_EXECUTION_DURATION_SECONDS=120
TESTAH_EXECUTION_MAX_TURNS=30
TESTAH_EXECUTION_MAX_TOOL_CALLS=25
TESTAH_EXECUTION_MAX_IDENTICAL_CALLS=3
TESTAH_EXECUTION_MAX_HTTP_REQUESTS=30
TESTAH_EXECUTION_MAX_MESSAGE_RESPONSES=3

# Explicit mock mode uses deterministic code, not an LLM or API credits.
TESTAH_RAI_PROVIDER=mock
# Real mode: provider=gemini, model=gemini-3.5-flash-lite, key=your Google Gemini API key.
# OpenAI remains supported: provider=openai and an account-available Responses model.
# Keep the key in an uncommitted backend environment or secret manager. Never use VITE_.
# Both Designer and RAI Examiner use these settings. Empty key/model fail explicitly.
TESTAH_RAI_MODEL=
TESTAH_RAI_API_KEY=
TESTAH_RAI_TIMEOUT_SECONDS=20
TESTAH_RAI_MAX_OUTPUT_TOKENS=3000
TESTAH_RAI_MAX_RESPONSE_BYTES=131072
TESTAH_RAI_RETRIES=1
TESTAH_RAI_REPAIR_ATTEMPTS=1
TESTAH_RAI_GENERATION_SECONDS=60
TESTAH_RAI_MAX_GENERATION_WORKERS=2
TESTAH_RAI_MAX_EXAMINER_MESSAGES=6
